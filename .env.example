# Node & Server
NODE_ENV=development
PORT=3000

# MongoDB Connection String (Atlas URI or local mongodb://localhost:27017/imovies)
# If left empty, IMovies automatically activates high-performance in-memory persistence with full MongoDB/Mongoose semantics
MONGODB_URI=""

# JWT Secret for User and Admin Authentication
JWT_SECRET="imovies_jwt_super_secret_production_key_2026_xyz"

# Client URL
CLIENT_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

